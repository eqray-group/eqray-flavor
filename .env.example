APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=11111

# 双令牌有效期（秒）：访问令牌 30 分钟，刷新令牌 7 天
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800
# Redis key 前缀
TOKEN_PREFIX=auth

# 缓存驱动：令牌、后续的权限集合都存在 Redis
CACHE_DRIVER=redis
CACHE_PREFIX=eqray_cache

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=go_starter
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# 支付：渠道配置存库（pay_app / pay_channel），这里只配置本模块对外可访问的地址
# 下单时下发给渠道的回调地址为 {PAY_NOTIFY_BASE_URL}/api/v1/pay/callbacks/order/{channelId}
PAY_NOTIFY_BASE_URL=
PAY_EXPIRE_MINUTES=15

# 微信支付 APIv3
PAY_WECHAT_ENABLED=false
PAY_WECHAT_APP_ID=
PAY_WECHAT_MCH_ID=
PAY_WECHAT_API_V3_KEY=
# 商户证书序列号
PAY_WECHAT_SERIAL_NO=
# 商户 API 私钥 apiclient_key.pem 的绝对路径
PAY_WECHAT_PRIVATE_KEY_PATH=
# 微信支付平台证书 pem 的绝对路径（校验回调签名用，可选）
PAY_WECHAT_PLATFORM_CERT_PATH=

# 支付宝
PAY_ALIPAY_ENABLED=false
PAY_ALIPAY_APP_ID=
# 应用私钥 pem 的绝对路径
PAY_ALIPAY_PRIVATE_KEY_PATH=
# 支付宝公钥 pem 的绝对路径
PAY_ALIPAY_PUBLIC_KEY_PATH=
PAY_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
PAY_ALIPAY_VERIFY_SIGN=true
